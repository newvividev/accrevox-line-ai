PORT=3000
DATABASE_URL=postgresql://postgres:postgres@db:5432/accrevox_line_mvp?schema=public

LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

ACCREVOX_BASE_URL=https://your-accrevox-host
ACCREVOX_CLIENT_ID=your-client-id
ACCREVOX_CLIENT_SECRET=your-client-secret
ACCREVOX_COMPANY_API_KEY=your-company-api-key

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3:latest

DEFAULT_BRANCH_CODE=00000
DEFAULT_VAT_METHOD=PER_ITEM
DEFAULT_PRICE_METHOD=INCLUSIVE
DEFAULT_APPROVAL_PERSON=
DEFAULT_CREATED_PERSON=

BOOTSTRAP_TENANT_ID=demo
BOOTSTRAP_TENANT_NAME=Demo Company
BOOTSTRAP_PACKAGE_PLAN=core
BOOTSTRAP_AI_MODE=credit
BOOTSTRAP_AI_ADDON_ENABLED=true
BOOTSTRAP_AI_CREDIT_BALANCE=1000
